msgid "plugins.themes.paideia.option.fonts.tooltip"
msgstr "Font disediakan oleh tema sendiri, tanpa Google Fonts. \"Font sistem\" memakai font perangkat pembaca dan merupakan opsi paling ringan."

msgid "plugins.themes.paideia.option.homeLayout.tooltip"
msgstr "Terbitan terkini: beranda menampilkan daftar isi terbitan terakhir. Publikasi berkelanjutan: terbitan terkini ditampilkan sebagai \"terbitan berjalan\" yang masih terbuka, dengan artikel dari yang terbaru, dan terbitan sebelumnya sebagai \"terbitan terakhir yang ditutup\". Artikel baru diterbitkan di terbitan terkini sampai terbitan berikutnya terbit."

msgid "plugins.themes.paideia.option.homeTabs.tooltip"
msgstr "Menggunakan statistik OJS dan diperbarui setiap 6 jam. Jika belum ada statistik, tab tidak ditampilkan."

msgid "plugins.themes.paideia.option.announcementBar.tooltip"
msgstr "Pembaca dapat menutupnya; bilah muncul lagi saat ada pengumuman baru."

msgid "plugins.themes.paideia.option.indexingPosition.label"
msgstr "Pengindeksan: posisi"

msgid "plugins.themes.paideia.option.indexingPosition.description"
msgstr "Tempat blok \"Terindeks di\" ditampilkan. Sebaiknya indeks diatur di sini, bukan di blok kustom bilah samping: tema mengatur desainnya dan logo tetap rapi."

msgid "plugins.themes.paideia.option.indexingPosition.top"
msgstr "Bagian atas beranda"

msgid "plugins.themes.paideia.option.indexingPosition.bottom"
msgstr "Bagian bawah semua halaman (di samping blok)"

msgid "plugins.themes.paideia.option.index.option"
msgstr "Terindeks (tampilkan di \"Terindeks di\")"

msgid "plugins.themes.paideia.option.index.url"
msgstr "Tautan ke jurnal di {$name}"

msgid "plugins.themes.paideia.option.index.urlDescription"
msgstr "Opsional. Dibuka di tab baru."

msgid "plugins.themes.paideia.option.indexing.tooltip"
msgstr "Gunakan tombol gambar untuk mengunggah logo dan tombol tautan untuk menambahkan alamat. Logo horizontal dengan lebar minimal 200 px paling sesuai."

msgid "plugins.themes.paideia.option.inlineHtml.tooltip"
msgstr "Meningkatkan keterbacaan dan pengindeksan di Google Scholar. Tautan galai HTML mengarah ke teks di halaman artikel."

msgid "plugins.themes.paideia.option.inlineStyle.tooltip"
msgstr "\"Tipografi tema\" disarankan untuk HTML yang dihasilkan dari JATS. \"Gaya galai\" mempertahankan desain galai yang ditata manual tanpa memengaruhi bagian lain halaman."

msgid "plugins.themes.paideia.option.inlineXpath.tooltip"
msgstr "Ekspresi XPath yang memilih bagian HTML galai yang ditampilkan. Berguna jika galai mengulang judul, penulis, atau abstrak yang sudah ada di halaman. Contoh: //div[@class='article-container']/*[not(contains(@class,'header'))]"

msgid "plugins.themes.paideia.option.articleRail.tooltip"
msgstr "\"Dikutip oleh\" menanyakan OpenAlex dari server (hanya mengirim DOI) dan menyimpan hasilnya 24 jam. \"Artikel terkait\" memakai kata kunci yang sama, tanpa indeks pencarian."

msgid "plugins.themes.paideia.option.seo.tooltip"
msgstr "JSON-LD (schema.org), Open Graph, tautan kanonis, dan citation_fulltext_html_url. Melengkapi plugin Google Scholar dan Dublin Core, bukan menggantikannya."

msgid "plugins.themes.paideia.option.footerColumns.tooltip"
msgstr "Isi footer diedit di Tampilan → Pengaturan → Footer halaman. Setiap garis horizontal (atau setiap judul) memulai kolom baru."

msgid "plugins.themes.paideia.option.footerIdentity.tooltip"
msgstr "Nama, ISSN, penerbit, dan tautan ke Tentang, Penyerahan, Arsip, dan Kontak, diambil dari pengaturan jurnal."

msgid "plugins.themes.paideia.option.cookieBar.tooltip"
msgstr "Tombol \"Terima\" dan \"Hanya yang diperlukan\"; pilihan disimpan di peramban pembaca. Tema tidak memblokir skrip pihak ketiga: analitik atau layanan lain harus diatur agar menghormati pilihan tersebut (event pdt:cookies). Jika sudah memakai plugin cookie, jangan aktifkan opsi ini."

msgid "plugins.themes.paideia.openIssue"
msgstr "Terbitan berjalan"

msgid "plugins.themes.paideia.openIssueNote"
msgstr "Publikasi berkelanjutan: artikel diterbitkan segera setelah siap, sampai terbitan ditutup."

msgid "plugins.themes.paideia.closedIssue"
msgstr "Terbitan terakhir yang ditutup"

msgid "plugins.themes.paideia.openIssueAll"
msgstr "Lihat semua {$count} artikel terbitan ini"

msgid "plugins.themes.paideia.openIssueEmpty"
msgstr "Belum ada artikel yang diterbitkan di terbitan ini."
