msgid "plugins.themes.paideia.option.fonts.tooltip"
msgstr "Fonts are served by the theme itself, without Google Fonts. \"System fonts\" uses the reader's device fonts and is the lightest option."

msgid "plugins.themes.paideia.option.homeLayout.tooltip"
msgstr "Current issue: the home page shows the table of contents of the latest issue. Continuous publication: the current issue is shown as the open \"issue in progress\", with its articles from newest to oldest, and the previous issue as the \"latest closed issue\". New articles are published in the current issue until the next one is published."

msgid "plugins.themes.paideia.option.homeTabs.tooltip"
msgstr "Uses OJS statistics and is refreshed every 6 hours. If there are no statistics yet, the tab is not shown."

msgid "plugins.themes.paideia.option.announcementBar.tooltip"
msgstr "Readers can close it; it comes back when a new announcement is published."

msgid "plugins.themes.paideia.option.indexingPosition.label"
msgstr "Indexing: placement"

msgid "plugins.themes.paideia.option.indexingPosition.description"
msgstr "Where the block is shown."

msgid "plugins.themes.paideia.option.indexingPosition.top"
msgstr "Top of the home page"

msgid "plugins.themes.paideia.option.indexingPosition.bottom"
msgstr "Bottom of every page (next to the blocks)"


msgid "plugins.themes.paideia.option.index.url"
msgstr "Link to the journal in {$name} (optional)"


msgid "plugins.themes.paideia.option.indexing.tooltip"
msgstr "Use the image button to upload the logo and the link button to add the address. Horizontal logos at least 200 px wide work best."

msgid "plugins.themes.paideia.option.inlineHtml.tooltip"
msgstr "Improves reading and Google Scholar indexing. The HTML galley link goes to the text on the article page."

msgid "plugins.themes.paideia.option.inlineStyle.tooltip"
msgstr "\"Theme typography\" is recommended for HTML generated from JATS. \"Galley styles\" keeps the design of hand-made galleys without affecting the rest of the page."

msgid "plugins.themes.paideia.option.inlineXpath.tooltip"
msgstr "XPath expression that selects which part of the galley HTML is shown. Useful when the galley repeats the title, authors or abstract already on the page. Example: //div[@class='article-container']/*[not(contains(@class,'header'))]"

msgid "plugins.themes.paideia.option.articleRail.tooltip"
msgstr "\"Cited by\" queries OpenAlex from the server (only the DOI is sent) and caches the result for 24 hours. \"Related articles\" uses shared keywords, not the search index."

msgid "plugins.themes.paideia.option.seo.tooltip"
msgstr "JSON-LD (schema.org), Open Graph, canonical link and citation_fulltext_html_url. It complements the Google Scholar and Dublin Core plugins; it does not replace them."

msgid "plugins.themes.paideia.option.footerColumns.tooltip"
msgstr "Footer content is edited in Appearance → Setup → Page footer. To split it into columns, open the source code with the editor's ‹/› button and type ‹hr› between columns (or start each column with an ‹h4› heading). If there are more columns than selected, the extra ones move to a second row."

msgid "plugins.themes.paideia.option.footerIdentity.tooltip"
msgstr "Name, ISSN, publisher and links to About, Submissions, Archive and Contact, taken from the journal settings."

msgid "plugins.themes.paideia.option.cookieBar.tooltip"
msgstr "\"Accept\" and \"Necessary only\" buttons; the choice is stored in the reader's browser. The theme does not block third-party scripts: analytics or other services must be set up to respect the choice (pdt:cookies event). If you already use a cookie plugin, leave this off."

msgid "plugins.themes.paideia.openIssue"
msgstr "Issue in progress"

msgid "plugins.themes.paideia.openIssueNote"
msgstr "Continuous publication: articles are published as soon as they are ready, until the issue closes."

msgid "plugins.themes.paideia.closedIssue"
msgstr "Latest closed issue"

msgid "plugins.themes.paideia.openIssueAll"
msgstr "See all {$count} articles in this issue"

msgid "plugins.themes.paideia.openIssueEmpty"
msgstr "No articles have been published in this issue yet."

msgid "plugins.themes.paideia.option.colour.label"
msgstr "Main colour"

msgid "plugins.themes.paideia.option.colour.description"
msgstr "Used for the header, buttons, links and tabs."

msgid "plugins.themes.paideia.option.support.label"
msgstr "Paideia Theme annual support"

msgid "plugins.themes.paideia.option.support.description"
msgstr "The theme is free. The annual support plan includes installing updates, tested on your OJS, help with bugs and advice on installation and use."

msgid "plugins.themes.paideia.option.support.link"
msgstr "Get the annual support plan"

msgid "plugins.themes.paideia.option.support.docs"
msgstr "Documentation"

msgid "plugins.themes.paideia.option.indexingOn.label"
msgstr "Indexed in"

msgid "plugins.themes.paideia.option.indexingOn.description"
msgstr "Shows the \"Indexed in\" block with the indexes ticked below. Ticking an index shows fields for the link to the journal's record and for its logo, both optional. Use this option rather than a custom sidebar block."

msgid "plugins.themes.paideia.option.indexingOn.option"
msgstr "Show the \"Indexed in\" block"

msgid "plugins.themes.paideia.option.index.logo"
msgstr "{$name} logo (optional)"

msgid "plugins.themes.paideia.option.index.logoDescription"
msgstr "PNG, JPG, WebP or GIF up to {$size} MB. It is fitted to the tile automatically without distortion; without a logo, the name is shown."
